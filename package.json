{
  "name": "shattered-web-dungeon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "build:local": "bash scripts/build-local-bundle.sh",
    "build:launcher:windows": "bash scripts/build-windows-launcher.sh",
    "dev:local": "vite --host 127.0.0.1",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:game": "node --import tsx scripts/game-smoke.ts",
    "test:architecture": "node --import tsx scripts/architecture-smoke.ts",
    "test:artifact": "node --import tsx scripts/artifact-smoke.ts && node scripts/local-server-smoke.mjs",
    "test:presentation": "node --import tsx scripts/presentation-smoke.ts",
    "test:rooms": "node --import tsx scripts/room-presets-smoke.ts",
    "test:special-rooms": "node --import tsx scripts/special-rooms-smoke.ts",
    "test:quests": "node --import tsx scripts/quest-smoke.ts",
    "test:enemy-registry": "node --import tsx scripts/enemy-registry-smoke.ts",
    "test:enemy-combat": "node --import tsx scripts/enemy-combat-smoke.ts",
    "test:boss": "node --import tsx scripts/boss-encounter-smoke.ts",
    "test:dungeon-progression": "node --import tsx scripts/dungeon-progression-smoke.ts",
    "test:companion-skills": "node --import tsx scripts/companion-skill-regression-smoke.ts",
    "test:materials": "node --import tsx scripts/material-currency-regression-smoke.ts",
    "test:perf": "node --import tsx scripts/performance-smoke.ts",
    "test:quick": "npm run lint && npm run test:architecture && npm run test:quests && npm run test:materials && npm run test:boss && npm run test:dungeon-progression && npm run test:game && npm run test:presentation && npm run test:perf",
    "verify:local": "bash scripts/verify-local.sh",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern local-dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "\ub179\ud53d\ub358 \uc6f9 \ub358\uc804"
}
